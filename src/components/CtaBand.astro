---
interface Props {
  tag: string;
  title: string;
  copy: string;
  href: string;
  label: string;
}
const { tag, title, copy, href, label } = Astro.props;
---

<section class="band section section--dark-2">
  <div class="wrap">
    <p class="tag">{tag}</p>
    <div class="card">
      <div>
        <h2>{title}</h2>
        <p>{copy}</p>
      </div>
      <a href={href} class="btn btn--accent">{label}</a>
    </div>
  </div>
</section>

<style>
  .band { position: relative; overflow: hidden; }
  .band::after {
    content: ''; position: absolute; right: -80px; top: -80px; width: 280px; height: 280px;
    background: var(--accent); opacity: 0.15; border-radius: 50%; pointer-events: none;
  }
  .card {
    position: relative; z-index: 1; background: var(--surface-dark); border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-lg); padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-6); flex-wrap: wrap;
  }
  h2 { font-size: var(--step-3); color: var(--text-on-dark); max-width: 20ch; }
  p { color: var(--text-on-dark-muted); margin-top: var(--space-3); max-width: 52ch; }
</style>
