---
interface Props {
  endpoint: string;
  submitLabel: string;
  successTitle: string;
  successCopy: string;
  /** Prefix for the WhatsApp fallback message if the API cannot be reached. */
  fallbackIntro: string;
}
const { endpoint, submitLabel, successTitle, successCopy, fallbackIntro } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---

<div class="lead-form" data-lead-form>
  <form method="post" action={endpoint} novalidate data-fallback-intro={fallbackIntro}>
    <div class="summary" role="alert" tabindex="-1" hidden></div>
    <div class="fields"><slot /></div>

    <!-- Honeypot: hidden from people, tempting to bots. -->
    <div class="hp" aria-hidden="true">
      <label for="f-website">Leave this empty</label>
      <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="idempotencyKey" />
    <input type="hidden" name="sourcePage" value={Astro.url.pathname} />

    <div class="turnstile" data-sitekey={siteKey}></div>

    <p class="purpose">We use these details only to reply to you. See our <a href="/privacy/">privacy note</a>.</p>

    <button class="btn btn--primary submit" type="submit">
      <span class="label">{submitLabel}</span>
      <span class="busy" aria-hidden="true"></span>
    </button>

    <div class="fallback" hidden>
      <p>We couldn't reach our server. Your message is not lost — send it on WhatsApp instead:</p>
      <a class="btn btn--accent" rel="noopener" href="#">Send on WhatsApp</a>
    </div>

    <noscript>
      <p class="purpose">This form needs JavaScript for its spam check. You can also call or WhatsApp us on 0548 935 585.</p>
    </noscript>
  </form>

  <div class="success" hidden>
    <h2 tabindex="-1">{successTitle}</h2>
    <p>Your reference is <strong class="ref"></strong>. Keep it in case you call us.</p>
    <p>{successCopy}</p>
    <a href="/" class="link-arrow">Back to the home page</a>
  </div>
</div>

<script>
  import { initLeadForms } from '../scripts/lead-form';
  initLeadForms();
</script>

<style>
  .lead-form { background: var(--surface); border-radius: var(--radius-lg); padding: clamp(1.25rem, 0.8rem + 2vw, 2rem); border: 1px solid var(--border); }
  form { display: grid; gap: var(--space-5); }
  .fields { display: grid; gap: var(--space-5); }
  .turnstile { min-width: 0; max-width: 100%; overflow: hidden; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .summary { background: color-mix(in oklab, var(--red) 8%, var(--surface)); border-left: 4px solid var(--danger); padding: var(--space-4); border-radius: var(--radius-sm); font-weight: 600; }
  .summary:focus { outline: none; }
  .purpose { font-size: var(--step--1); color: var(--text-muted); }
  .purpose a { color: var(--text-accent); font-weight: 600; }
  .submit { justify-self: start; min-width: 12rem; position: relative; }
  .busy { display: none; width: 1.1em; height: 1.1em; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; }
  .submit[aria-busy='true'] .busy { display: inline-block; animation: spin 0.8s linear infinite; }
  .submit[aria-busy='true'] { cursor: progress; }
  @keyframes spin { to { rotate: 1turn; } }
  @media (prefers-reduced-motion: reduce) { .submit[aria-busy='true'] .busy { animation-duration: 2.4s; } }
  .fallback { display: grid; gap: var(--space-3); justify-items: start; background: var(--surface-soft); padding: var(--space-4); border-radius: var(--radius-sm); border-left: 4px solid var(--accent); }
  .fallback[hidden] { display: none; }
  .success { display: grid; gap: var(--space-3); justify-items: start; }
  .success[hidden] { display: none; }
  .success h2 { font-size: var(--step-3); }
  .success h2:focus { outline: none; }
  .ref { font-family: var(--font-display); font-size: 1.2em; background: var(--accent); color: var(--accent-on); padding: 0 0.35em; border-radius: 6px; letter-spacing: 0.04em; }
</style>
