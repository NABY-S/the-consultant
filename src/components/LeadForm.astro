---
import Icon from './Icon.astro';
import { TURNSTILE_ENABLED } from '../lib/leads/turnstile';

interface Props {
  endpoint: string;
  /**
   * `api`: JSON to our own endpoint, with Turnstile and a reference number.
   * `google`: posts the fields straight into a Google Form's formResponse URL.
   */
  mode?: 'api' | 'google';
  /** `google` only: text question that carries answers named `extra.*`. */
  foldInto?: string;
  submitLabel: string;
  successTitle: string;
  successCopy: string;
  /** Prefix for the WhatsApp fallback message if the form cannot be sent. */
  fallbackIntro: string;
}
const { endpoint, mode = 'api', foldInto, submitLabel, successTitle, successCopy, fallbackIntro } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---

<div class="lead-form" data-lead-form data-mode={mode}>
  <form method="post" action={endpoint} novalidate data-fallback-intro={fallbackIntro} data-fold-into={foldInto}>
    <div class="summary" role="alert" tabindex="-1" hidden></div>
    <div class="fields"><slot /></div>

    <!-- Honeypot: hidden from people, tempting to bots. -->
    <div class="hp" aria-hidden="true">
      <label for="f-website">Leave this empty</label>
      <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    {
      mode === 'api' && (
        <>
          <input type="hidden" name="idempotencyKey" />
          <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
          {TURNSTILE_ENABLED && <div class="turnstile" data-sitekey={siteKey} />}
        </>
      )
    }

    <div class="actions">
      <button class="btn btn--primary submit" type="submit">
        <span class="busy" aria-hidden="true"></span>
        <span class="label">{submitLabel}</span>
        <Icon name="arrow" size={18} />
      </button>
      <p class="purpose">
        We only use these details to reply to you. By sending, you agree to our <a href="/terms/">terms</a> and{" "}
        <a href="/privacy/">privacy policy</a>.
      </p>
    </div>

    <div class="fallback" hidden>
      <p><strong>We couldn't send that.</strong> Nothing is lost. Send the same details on WhatsApp instead:</p>
      <a class="btn btn--primary" rel="noopener" href="#">Send on WhatsApp</a>
    </div>

    {
      mode === 'api' && TURNSTILE_ENABLED && (
        <noscript>
          <p class="purpose">This form needs JavaScript for its spam check. You can also call or WhatsApp us on 0548 935 585.</p>
        </noscript>
      )
    }
  </form>

  <div class="success" hidden>
    <span class="done" aria-hidden="true"><Icon name="check" size={28} /></span>
    <h2 tabindex="-1">{successTitle}</h2>
    <p class="ref-line" hidden>Your reference is <strong class="ref"></strong>. Keep it in case you call us.</p>
    <p>{successCopy}</p>
    <a href="/" class="link-arrow">Back to the home page <Icon name="arrow" size={18} /></a>
  </div>
</div>

<script>
  import { initLeadForms } from '../scripts/lead-form';
  initLeadForms();
</script>

<style>
  .lead-form {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 0.75rem + 2.4vw, 2.5rem);
    box-shadow: var(--shadow-card);
  }
  form { display: grid; gap: var(--space-6); }
  form[hidden] { display: none; }
  .fields { display: grid; gap: var(--space-5); }
  .turnstile { min-width: 0; max-width: 100%; overflow: hidden; }
  .turnstile:empty { display: none; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }

  .summary {
    background: color-mix(in oklab, var(--red) 7%, var(--surface));
    border: 1px solid color-mix(in oklab, var(--red) 30%, transparent);
    color: var(--danger); padding: 0.85rem 1rem; border-radius: var(--radius-md); font-weight: 500;
  }
  .summary:focus { outline: none; }

  .actions {
    display: flex; align-items: center; gap: var(--space-4) var(--space-5); flex-wrap: wrap;
    padding-top: var(--space-5); border-top: 1px solid var(--border);
  }
  .purpose { font-size: var(--step--1); color: var(--text-muted); flex: 1 1 14rem; }
  .purpose a { color: var(--text); font-weight: 500; text-underline-offset: 3px; }
  .submit { min-width: 13rem; }
  .busy { display: none; width: 1.05em; height: 1.05em; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; }
  .submit[aria-busy='true'] .busy { display: inline-block; animation: spin 0.8s linear infinite; }
  .submit[aria-busy='true'] :global(svg) { display: none; }
  .submit[aria-busy='true'] { cursor: progress; }
  @keyframes spin { to { rotate: 1turn; } }
  @media (prefers-reduced-motion: reduce) { .submit[aria-busy='true'] .busy { animation-duration: 2.4s; } }

  .fallback {
    display: grid; gap: var(--space-3); justify-items: start;
    background: var(--surface-soft); padding: var(--space-5); border-radius: var(--radius-md); border: 1px solid var(--border);
  }
  .fallback[hidden] { display: none; }

  .success { display: grid; gap: var(--space-3); justify-items: start; padding-block: var(--space-4); }
  .success[hidden], .ref-line[hidden] { display: none; }
  .done {
    width: 56px; height: 56px; border-radius: var(--radius-lg); display: grid; place-items: center;
    background: color-mix(in oklab, var(--green) 10%, var(--surface)); color: var(--success);
    border: 1px solid color-mix(in oklab, var(--green) 30%, transparent);
    margin-bottom: var(--space-2);
  }
  .success h2 { font-size: var(--step-3); }
  .success h2:focus { outline: none; }
  .success p { color: var(--text-muted); max-width: 48ch; }
  .ref { font-family: var(--font-mono); color: var(--text); background: var(--surface-sunk); padding: 0.1em 0.4em; border-radius: 6px; letter-spacing: 0.04em; }

  @media (prefers-reduced-motion: no-preference) {
    .success:not([hidden]) { animation: pop 420ms var(--ease-out) both; }
  }
  @keyframes pop { from { opacity: 0; translate: 0 10px; } }

  @media (max-width: 560px) {
    .submit { width: 100%; }
  }
</style>
