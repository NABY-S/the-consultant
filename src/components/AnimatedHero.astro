---
/**
 * Full-bleed photo hero with a staggered entrance and glass buttons.
 * Astro/CSS port of the "animated hero section" pattern: no client JS.
 * Pair with <Base overlayHeader> so the site header floats over the image.
 */
import Icon from './Icon.astro';

interface Action {
  text: string;
  href: string;
  external?: boolean;
}

interface Props {
  image: { src: string; srcset?: string; alt?: string };
  title: string;
  /** Optional second line of the headline, set in the accent colour. */
  titleAccent?: string;
  description: string;
  ctaButton: Action;
  secondaryCta?: Action;
}

const { image, title, titleAccent, description, ctaButton, secondaryCta } = Astro.props;
const rel = (a: Action) => (a.external ? 'noopener' : undefined);
---

<section class="hero">
  <div class="media" aria-hidden="true">
    <img src={image.src} srcset={image.srcset} sizes="100vw" alt={image.alt ?? ''} fetchpriority="high" decoding="async" />
  </div>

  <div class="content wrap">
    <h1>
      {title}
      {titleAccent && <span>{titleAccent}</span>}
    </h1>
    <p class="lead">{description}</p>
    <div class="ctas">
      <a href={ctaButton.href} rel={rel(ctaButton)} class="btn btn--glass btn--glass-strong">
        {ctaButton.text} <Icon name="arrow" size={18} />
      </a>
      {
        secondaryCta && (
          <a href={secondaryCta.href} rel={rel(secondaryCta)} class="btn btn--glass">
            {secondaryCta.text}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; align-items: center;
    min-height: 95vh;
    min-height: 95svh;
    padding-block: calc(var(--header-h) + var(--space-7)) var(--space-8);
    background: var(--surface-dark); color: var(--white);
  }

  .media { position: absolute; inset: 0; z-index: -1; }
  /* Keep the two faces (right third) in frame as the viewport narrows. */
  .media img { width: 100%; height: 100%; object-fit: cover; object-position: 78% 35%; filter: saturate(0.75) contrast(1.05); }
  /* Readability scrim: heavier on the text side and at the bottom edge. */
  .media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, color-mix(in oklab, var(--gray-950) 88%, transparent) 0%,
        color-mix(in oklab, var(--gray-950) 62%, transparent) 55%,
        color-mix(in oklab, var(--gray-950) 40%, transparent) 100%),
      linear-gradient(to top, color-mix(in oklab, var(--gray-950) 70%, transparent), transparent 40%);
  }

  .content { display: flex; flex-direction: column; align-items: flex-start; }
  h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);
    line-height: 1.02; letter-spacing: -0.045em; max-width: 14ch;
  }
  h1 span { display: block; color: var(--accent); }
  .lead {
    margin-top: var(--space-5); max-width: 44ch;
    font-size: var(--step-1); line-height: 1.5;
    color: color-mix(in oklab, var(--white) 78%, transparent);
  }
  .ctas { margin-top: var(--space-7); display: flex; flex-wrap: wrap; gap: var(--space-3); }

  @media (prefers-reduced-motion: no-preference) {
    .media img { animation: settle 1600ms var(--ease-out) both; }
    /* Stagger: 200ms lead-in, 150ms between items, 600ms each. */
    .content > * { animation: rise 600ms ease-out both; }
    .content > :nth-child(1) { animation-delay: 200ms; }
    .content > :nth-child(2) { animation-delay: 350ms; }
    .content > :nth-child(3) { animation-delay: 500ms; }
  }
  @keyframes settle { from { scale: 1.06; } }
  @keyframes rise { from { opacity: 0; translate: 0 20px; } }

  @media (max-width: 560px) {
    .hero { padding-block: calc(var(--header-h) + var(--space-8)) var(--space-8); }
    .ctas { width: 100%; }
    .ctas .btn { flex: 1 1 100%; }
  }
</style>
