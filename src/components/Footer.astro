---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="brand-mini">THE CONSULTANT</p>
      <p class="muted">{site.tagline}. {site.location}.</p>
    </div>
    <nav aria-label="Footer">
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/apply/">Apply for training</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>
    <div class="contact">
      <p>{site.phones.map((p, i) => <>{i > 0 && ' / '}<a href={`tel:${p.tel}`}>{p.display}</a></>)}</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>
  <div class="wrap base">
    <p>&copy; {year} The Consultant, Ghana</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-deep); color: var(--sand-muted);
    padding-block: var(--space-7) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    font-size: var(--step--1);
  }
  .grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: var(--space-6); }
  .brand-mini { color: var(--cream); font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; margin-bottom: var(--space-2); }
  ul { display: grid; grid-template-columns: repeat(2, max-content); gap: var(--space-1) var(--space-6); }
  a { color: var(--cream); text-decoration: none; display: inline-flex; align-items: center; min-height: 36px; }
  a:hover { color: var(--orange); text-decoration: underline; }
  .contact p + p { margin-top: var(--space-1); }
  .base { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid color-mix(in oklab, var(--cream) 10%, transparent); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
