---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found" noindex>
  <PageHero path={[{ label: '404' }]} title="This page took a different path." lead="The link may be old or mistyped. These will get you back on track:">
    <div class="ctas">
      <a href="/" class="btn btn--glass btn--glass-strong">Go to the home page</a>
      <a href="/training/" class="btn btn--glass">Browse training</a>
    </div>
  </PageHero>
</Base>

<style>
  .ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; align-items: center; margin-top: var(--space-6); }
</style>
