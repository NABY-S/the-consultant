---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="page-hero wrap nf">
    <p class="tag">404</p>
    <h1>This page took a different path.</h1>
    <p class="lead">The link may be old or mistyped. These will get you back on track:</p>
    <div class="ctas">
      <a href="/" class="btn btn--primary">Go to the home page</a>
      <a href="/training/" class="btn btn--ghost">Browse training</a>
      <a href="/contact/" class="link-arrow">Contact us</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 60dvh; }
  .ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; align-items: center; margin-top: var(--space-6); }
</style>
