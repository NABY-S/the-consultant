---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PathRail from '../components/PathRail.astro';
import TrackCard from '../components/TrackCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { whatsappLink } from '../data/site';

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.order - b.data.order);
const featured = tracks.slice(0, 6);
---

<Base title="The Consultant">
  <section class="hero">
    <div class="hero-grid wrap">
      <div class="hero-copy">
        <p class="eyebrow">IT · Computer Science · Software Development</p>
        <h1>
          Got an idea, a project<br class="br" /> or a problem to solve?
          <span class="highlight">Let's build it.</span>
        </h1>
        <p class="lead">
          The Consultant is a Ghana-based technology firm helping students, businesses and institutions turn ideas into
          working software — from final year projects to full-scale business platforms.
        </p>
        <div class="ctas">
          <a href={whatsappLink('Hello The Consultant, I have a project I would like to discuss.')} class="btn btn--primary" rel="noopener">
            Send us a DM
          </a>
          <a href="/services/" class="btn btn--ghost">See our services</a>
        </div>
      </div>

      <aside class="hero-panel" aria-labelledby="why-title">
        <h2 id="why-title">Why teams and students work with us</h2>
        <ul role="list">
          <li>Final year & industrial projects built and documented start to finish</li>
          <li>Custom websites and software for any kind of business</li>
          <li>Training from JHS1 through university level, in IT & Computer Science</li>
          <li>Based in Ghana, working with clients wherever they are</li>
        </ul>
      </aside>
    </div>
  </section>

  <PathRail />

  <section class="section section--white" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="section-head">
        <p class="tag">What we do</p>
        <h2 id="svc-title">Services built around your stage</h2>
        <p>Whether you're building a business, finishing a degree, or just starting to learn — there is a track for it.</p>
      </div>
      <ol class="svc-list" role="list">
        {
          services.map((s, i) => (
            <li class="svc">
              <span class="svc-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="icon-tile">
                <Icon name={s.icon} />
              </div>
              <div class="svc-body">
                <p class="svc-aud">{s.audience}</p>
                <h3>{s.title}</h3>
                <p>{s.summary}</p>
              </div>
              <a class="link-arrow svc-link" href={s.cta.href}>
                {s.cta.label} <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="tr-title">
    <div class="wrap">
      <div class="section-head">
        <p class="tag">Skill up</p>
        <h2 id="tr-title">Our training programs</h2>
        <p>Ten hands-on tracks covering the most in-demand tech skills — taught at JHS, SHS and university level.</p>
      </div>
      <div class="tr-grid">
        {featured.map((t) => <TrackCard track={t} compact />)}
      </div>
      <p class="more-tracks">
        <a class="link-arrow" href="/training/">See all {tracks.length} tracks <Icon name="arrow" size={18} /></a>
      </p>
    </div>
  </section>

  <CtaBand
    tag="Training enrolment"
    title="Ready to join a training course?"
    copy="Apply online in about three minutes — JHS, SHS or university level. We confirm your start date and fees by phone or WhatsApp."
    href="/apply/"
    label="Apply for training"
  />

  <section class="section section--dark" aria-labelledby="contact-title">
    <div class="wrap contact-teaser">
      <div class="section-head">
        <p class="tag">Get in touch</p>
        <h2 id="contact-title">Tell us what you're building</h2>
        <p>Send a message, call, or chat on WhatsApp — we usually reply the same day.</p>
      </div>
      <div class="ctas">
        <a href="/contact/" class="btn btn--accent">Send a message</a>
        <a href={whatsappLink()} class="btn btn--ghost on-dark" rel="noopener">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, var(--cream) 0 48%, var(--ink) 48% 100%);
    padding-block: var(--space-8) calc(var(--space-8) + var(--space-5));
  }
  .hero::before {
    content: ''; position: absolute; inset-block: 0; left: 44%; width: 6%;
    background: var(--accent); transform: skewX(-12deg); opacity: 0.9;
  }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-7); align-items: center; }
  .eyebrow { color: var(--text-accent); font-weight: 700; font-size: var(--step--1); margin-bottom: var(--space-4); }
  h1 { font-size: var(--step-4); }
  .highlight {
    display: inline-block; margin-top: var(--space-2);
    background: var(--accent); color: var(--accent-on);
    padding: 0.05em 0.35em; border-radius: var(--radius-sm);
    rotate: -1.5deg;
  }
  @media (prefers-reduced-motion: no-preference) {
    .highlight { animation: stamp 620ms var(--ease-spring) 280ms both; }
  }
  @keyframes stamp {
    from { opacity: 0; scale: 1.35; rotate: -7deg; }
    to { opacity: 1; scale: 1; rotate: -1.5deg; }
  }
  .lead { margin-top: var(--space-5); font-size: var(--step-1); line-height: 1.5; max-width: 46ch; color: var(--text-muted); }
  .ctas { margin-top: var(--space-6); display: flex; gap: var(--space-4); flex-wrap: wrap; }

  .hero-panel {
    background: var(--surface-dark-2); color: var(--text-on-dark);
    border-radius: var(--radius-lg); padding: var(--space-6); border: 1px solid var(--border-on-dark);
  }
  .hero-panel h2 { color: var(--accent-on-dark); font-size: var(--step-1); margin-bottom: var(--space-4); }
  .hero-panel ul { display: grid; gap: var(--space-3); }
  .hero-panel li { display: grid; grid-template-columns: 1.2em 1fr; gap: var(--space-2); }
  .hero-panel li::before { content: '→'; color: var(--accent-on-dark); font-weight: 700; }

  .svc-list { display: grid; }
  .svc {
    display: grid; grid-template-columns: 3rem 48px 1fr auto; gap: var(--space-5); align-items: start;
    padding-block: var(--space-6); border-top: 1px solid var(--border);
  }
  .svc:last-child { border-bottom: 1px solid var(--border); }
  .svc-num { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); color: var(--text-accent); line-height: 1; padding-top: 4px; }
  .svc-aud { font-size: var(--step--1); font-weight: 600; color: var(--text-accent); }
  .svc h3 { font-size: var(--step-2); margin-block: var(--space-1) var(--space-2); }
  .svc-body > p:last-child { color: var(--text-muted); max-width: 56ch; }
  .svc-link { align-self: center; white-space: nowrap; }

  .tr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: var(--space-6) var(--space-5); }
  .more-tracks { margin-top: var(--space-6); }

  .contact-teaser { display: flex; justify-content: space-between; align-items: end; gap: var(--space-6); flex-wrap: wrap; }
  .contact-teaser .section-head { margin-bottom: 0; }
  .contact-teaser .ctas { margin-top: 0; }
  .on-dark { color: var(--text-on-dark); }
  .on-dark:hover { background: color-mix(in oklab, var(--cream) 10%, transparent); }

  @media (max-width: 900px) {
    .svc { grid-template-columns: 48px 1fr; }
    .svc-num { display: none; }
    .svc-link { grid-column: 2; justify-self: start; }
  }
  @media (max-width: 820px) {
    .hero { background: var(--cream); padding-block: var(--space-7); }
    .hero::before { display: none; }
    .hero-grid { grid-template-columns: 1fr; }
    .br { display: none; }
  }
</style>
