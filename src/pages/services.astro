---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { path } from '../data/site';
---

<Base
  title="Web Development, Final Year Projects & IT Training"
  description="Websites and custom software for businesses, final year and industrial projects for IT and Computer Science students, and monthly tech training in Ghana."
>
  <PageHero
    path={[{ label: 'services' }]}
    title="Three ways we help, one way of working"
    lead="Pick the track that matches where you are. Every engagement follows the same five-stage path."
    specs={path.map((p, i) => ({ label: String(i + 1).padStart(2, '0'), value: p.step }))}
    specsTitle="Delivery path"
  />

  {
    services.map((s, i) => (
      <section id={s.slug} class:list={['section', i % 2 === 0 ? 'section--white' : '']}>
        <div class:list={['wrap', 'row', { flip: i % 2 === 1 }]}>
          <div class="lede">
            <div class="icon-tile"><Icon name={s.icon} /></div>
            <p class="tag">{s.audience}</p>
            <h2>{s.title}</h2>
            <p>{s.summary}</p>
            <a href={s.cta.href} class="btn btn--primary">{s.cta.label}</a>
          </div>
          <div class="detail">
            <h3>What's included</h3>
            <ul class="bullets" role="list">{s.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand
    tag="Not sure which fits?"
    title="Describe it in a sentence. We'll tell you."
    copy="Send us a message with your idea, deadline or problem and we'll recommend the right track."
    href="/contact/"
    label="Send a message"
  />
</Base>

<style>
  .row { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-7); align-items: center; }
  .row.flip .lede { order: 2; }
  .lede .icon-tile { margin-bottom: var(--space-5); }
  .lede h2 { font-size: var(--step-3); }
  .lede > p:not(.tag) { margin-block: var(--space-4) var(--space-6); color: var(--text-muted); font-size: var(--step-1); line-height: 1.5; max-width: 50ch; }
  .detail { background: var(--surface-soft); border-radius: var(--radius-lg); padding: var(--space-6); border: 1px solid var(--border); box-shadow: var(--shadow-card); }
  .section:not(.section--white) .detail { background: var(--surface); }
  .detail h3 { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px dashed var(--border-strong); }
  @media (max-width: 820px) {
    .row { grid-template-columns: 1fr; }
    .row.flip .lede { order: 0; }
  }
</style>
